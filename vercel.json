{
  "version": 2,
  "routes": [
    {
      "src": "/frames/(.*)",
      "dest": "https://images.pregonerosdemedellin.com/data/$1"
    },
    {
      "src": "/classic",
      "status": 308,
      "headers": {
        "Location": "/classic/"
      }
    },
    {
      "src": "/classic/",
      "dest": "/api/index.js",
      "methods": [
        "GET"
      ]
    },
    {
      "src": "/m(/.*)?",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}
